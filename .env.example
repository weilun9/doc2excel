# Doc2Excel settings. Copy to `.env` next to Doc2Excel.exe, or use the in-app
# Settings screen, which edits the same file.
# API keys (LLM_API_KEY, VISION_API_KEY, ERP_TOKEN) are kept in Windows
# Credential Manager, not here: a key typed into this file is moved there the
# next time Doc2Excel starts, and its line here is left blank.

# Text LLM that turns OCR text into a table (any OpenAI-compatible API).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional vision LLM for higher-quality OCR when online (OpenAI-compatible,
# must accept images). Leave blank to always use the built-in local OCR.
# Example (Qwen-VL): https://dashscope-intl.aliyuncs.com/compatible-mode/v1  /  qwen-vl-max
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# auto = vision model if configured and reachable, else local | local | vision
OCR_MODE=auto
# auto = AI when the API is reachable, else offline rules | online | offline
AI_MODE=auto

# SmartAcc DynaMod supplier bills ("DynaMod 进单" button).
# DYNAMOD_WORKBOOK: your own 进单整理模板 .xlsx (its 供应商 and 条码对照 sheets give
#   Supplier IDs, system barcodes and PCS per CTN). It stays on this PC.
# DYNAMOD_TEMPLATE_DIR: folder with DynaMod's blank SupplierInvoice.xlsx /
#   SupplierCreditNote.xlsx (a built-in copy is used if not found).
# DYNAMOD_OUT_DIR: where one import file per bill is written.
DYNAMOD_WORKBOOK=
DYNAMOD_TEMPLATE_DIR=C:\SmartAcc\DynaMod\Import Template
DYNAMOD_OUT_DIR=C:\Opp
DYNAMOD_LOCATION=HQ

# Folder watched while the app is open (scanner software can save here).
# Blank = default Documents\Doc2Excel\Inbox
WATCH_DIR=
SERVER_PORT=8765
UI_LANG=zh
